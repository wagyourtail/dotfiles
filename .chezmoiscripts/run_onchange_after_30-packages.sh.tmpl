#!/usr/bin/env bash
# run_onchange_after_30-packages: install every package slice that applies to
# this machine. chezmoi re-runs this whenever the rendered script changes — and
# the per-slice checksums below change whenever a packages/*.txt file does.
#
# role={{ .role }} des={{ .des }} hostname={{ .chezmoi.hostname }}
set -euo pipefail

command -v paru >/dev/null || { echo "paru missing — run run_once_after_20 first"; exit 1; }

{{- $des := splitList "," .des }}
{{- $groups := list "base" "common-cli" }}
{{- if ne .role "server" }}{{ $groups = append $groups "dev" }}{{ end }}
{{- $hasDe := false }}
{{- range $des }}{{ if has . (list "hyprland" "cosmic") }}{{ $hasDe = true }}{{ end }}{{ end }}
{{- if $hasDe }}{{ $groups = append $groups "common-gui" }}{{ end }}
{{- range $des }}
{{-   if has . (list "hyprland" "cosmic") }}
{{-     $groups = append $groups (printf "de-%s" .) }}
{{-   end }}
{{- end }}
{{- $groups = append $groups (printf "role-%s" .role) }}
{{- $groups = append $groups (printf "host-%s" .chezmoi.hostname) }}
{{- $extras := index . "extras" | default "" }}
{{- range splitList "," $extras }}
{{-   if . }}{{ $groups = append $groups . }}{{ end }}
{{- end }}

SLICES=( {{ join " " $groups }} )

# Slice contents hashed so edits re-trigger this script:
{{- range $groups }}
{{-   $h := "" }}
{{-   $f := printf "packages/%s.txt" . }}
{{-   if stat (joinPath $.chezmoi.sourceDir $f) }}{{ $h = include $f | sha256sum }}{{ end }}
{{-   $fa := printf "packages/%s.aur.txt" . }}
{{-   if stat (joinPath $.chezmoi.sourceDir $fa) }}{{ $h = print $h (include $fa | sha256sum) }}{{ end }}
# {{ . }}: {{ $h }}
{{- end }}

PKGDIR="{{ .chezmoi.sourceDir }}/packages"

pkgs=()
for g in "${SLICES[@]}"; do
    for f in "$PKGDIR/$g.txt" "$PKGDIR/$g.aur.txt"; do
        [[ -f $f ]] || continue
        while IFS= read -r line; do
            line="${line%%#*}"            # strip comments
            line="${line//[[:space:]]/}"  # strip whitespace
            [[ -n $line ]] && pkgs+=("$line")
        done < "$f"
    done
done

# NB: guard before the sort — `printf '%s\n' "${pkgs[@]}"` on an empty array
# emits one empty line, which sort -u would turn into a bogus 1-element array.
((${#pkgs[@]})) || { echo "no packages"; exit 0; }
mapfile -t pkgs < <(printf '%s\n' "${pkgs[@]}" | sort -u)

# ── preflight ──────────────────────────────────────────────────────────────────
# `paru --noconfirm` dies silently on replace prompts ("X and Y are in
# conflict"). Resolve them up front: one `paru -Si` for the whole list,
# intersected against installed packages AND their provides. On a TTY we ask
# keep/replace per conflict; unattended (piped init, ISO) we list them and exit
# non-zero — loud failure, never a mid-transaction stall.

si=$(mktemp)
trap 'rm -f "$si"' EXIT
paru -Si "${pkgs[@]}" >"$si" 2>/dev/null || true

# names the repos/AUR don't know (typos, dropped packages) — warn only
unknown=$(comm -23 <(printf '%s\n' "${pkgs[@]}") \
    <(awk '/^Name[[:space:]]*:/ {print $NF}' "$si" | sort -u))
[[ -n $unknown ]] && printf 'warning: not found in repos or AUR: %s\n' $unknown >&2

declare -A installed provider requested
mapfile -t _inst < <(pacman -Qq)
for _p in "${_inst[@]}"; do installed["$_p"]=1; done
for _p in "${pkgs[@]}"; do requested["$_p"]=1; done
while read -r _o _v; do provider["$_v"]="$_o"; done < <(pacman -Qi | awk '
    /^Name[[:space:]]*:/     { n=$NF }
    /^Provides[[:space:]]*:/ { for(i=3;i<=NF;i++){v=$i;sub(/=.*/,"",v);if(v!="None")print n,v} }
')

# chezmoi runs scripts with stdin detached — prompt via /dev/tty when a
# controlling terminal exists (curl|sh installer trick); /dev/tty open fails
# (ENXIO) when there is none.
tty_ok=0
if { exec 3<>/dev/tty; } 2>/dev/null; then tty_ok=1; fi

# remembered keep-decisions live outside the repo (machine-local state);
# "want inst" per line. To make one permanent, rename want→inst in packages/.
OVERRIDES="${XDG_STATE_HOME:-$HOME/.local/state}/dots/pkg-overrides"
declare -A keep_for
if [[ -f $OVERRIDES ]]; then
    while read -r _w _i; do [[ -n $_w && -n $_i ]] && keep_for["$_w"]="$_i"; done < "$OVERRIDES"
fi

declare -A seen drop
bad=0
while read -r want conflict cop cver; do
    [[ -n $want && -n $conflict && $conflict != "$want" ]] || continue
    inst=""
    [[ -n ${installed[$conflict]:-} ]] && inst=$conflict
    if [[ -z $inst && -n ${provider[$conflict]:-} && ${provider[$conflict]} != "$want" ]]; then
        inst=${provider[$conflict]}
    fi
    [[ -z $inst ]] && continue
    # versioned constraints only conflict when the installed version violates
    # them (e.g. "xdg-desktop-portal-gtk<1.10.0-2" is a no-op on newer gtk).
    if [[ -n $cop && -n $cver ]]; then
        iver=$(pacman -Q "$inst" 2>/dev/null | awk '{print $2}')
        if command -v vercmp >/dev/null; then
            rc=$(vercmp "$iver" "$cver")
            case $cop in
                "<")  (( rc < 0 )) || continue ;;
                "<=") (( rc <= 0 )) || continue ;;
                ">")  (( rc > 0 )) || continue ;;
                ">=") (( rc >= 0 )) || continue ;;
                "=")  (( rc == 0 )) || continue ;;
                *) continue ;;  # unknown op — don't flag
            esac
        fi
        # no vercmp (pre-pacman-contrib bootstrap): flag conservatively
    fi
    [[ -z ${seen[$want/$inst]:-} ]] || continue
    seen["$want/$inst"]=1
    if [[ ${keep_for[$want]:-} == "$inst" ]]; then
        drop["$want"]=1
        echo "keeping $inst over $want (remembered — see $OVERRIDES)"
        continue
    fi
    if ((tty_ok)); then
        printf '\nconflict: %s (slice) vs installed %s\n' "$want" "$inst" >&3
        read -rp "  [r]eplace $inst, or [k]eep it permanently [k] " ans <&3 || ans=k
        case ${ans,,} in
            r|replace) paru -S "$want" <&3 ;;   # paru resolves the removal itself
            *) drop["$want"]=1
               mkdir -p "${OVERRIDES%/*}"
               printf '%s %s\n' "$want" "$inst" >> "$OVERRIDES"
               echo "  keeping $inst (remembered) — rename $want→$inst in packages/ to make it permanent" >&3 ;;
        esac
    else
        printf 'conflict: %s (requested) vs %s (installed)\n' "$want" "$inst" >&2
        bad=1
    fi
done < <(
    # forward: requested pkg declares conflict on an installed name/provider
    # emits: want conflict-name op version (op/ver empty when unversioned)
    awk '
        /^Name[[:space:]]*:/           { n=$NF }
        /^Conflicts With[[:space:]]*:/ {
            for(i=4;i<=NF;i++){
                v=$i; if(v=="None")continue
                if(match(v,/[<>=]+/)){print n,substr(v,1,RSTART-1),substr(v,RSTART,RLENGTH),substr(v,RSTART+RLENGTH)}
                else{print n,v,"",""}
            }
        }
    ' "$si"
    # reverse: installed pkg declares conflict on a requested name
    # (e.g. gamescope-git declares "conflicts: gamescope" — repo side is silent)
    awk 'NR==FNR { req[$1]=1; next }
        /^Name[[:space:]]*:/           { n=$NF }
        /^Conflicts With[[:space:]]*:/ {
            for(i=4;i<=NF;i++){
                v=$i; if(v=="None")continue
                if(match(v,/[<>=]+/)){nm=substr(v,1,RSTART-1);op=substr(v,RSTART,RLENGTH);ver=substr(v,RSTART+RLENGTH)}
                else{nm=v;op="";ver=""}
                if(nm in req)print nm,n,op,ver
            }
        }
    ' <(printf '%s\n' "${pkgs[@]}") <(pacman -Qi)
)

if ((bad)); then
    exec 3>&- 3<&-
    echo "resolve the conflicts above (pacman -Rns or packages/ edits), then re-apply" >&2
    exit 1
fi

if [[ -n ${drop[@]+x} ]]; then
    kept=()
    for _p in "${pkgs[@]}"; do [[ -z ${drop[$_p]:-} ]] && kept+=("$_p"); done
    pkgs=("${kept[@]}")
    ((${#pkgs[@]})) || { echo "nothing left to install"; exit 0; }
fi

echo "installing ${#pkgs[@]} packages from slices: ${SLICES[*]}"
if ((tty_ok)); then
    # interactive: paru resolves conflicts/providers itself (stdin = /dev/tty,
    # since chezmoi detaches script stdin)
    paru -S --needed "${pkgs[@]}" <&3
    exec 3>&- 3<&-
else
    paru -S --needed --noconfirm "${pkgs[@]}"
fi
{{ if $hasDe }}
# flatpak slice — user-scope installs, skipped entirely on headless roles
if command -v flatpak >/dev/null && [[ -f $PKGDIR/flatpak.txt ]]; then
    flatpak remote-add --user --if-not-exists flathub \
        https://flathub.org/repo/flathub.flatpakrepo || true
    mapfile -t fpkgs < <(grep -vE '^\s*(#|$)' "$PKGDIR/flatpak.txt" | awk '{print $1}')
    ((${#fpkgs[@]})) && flatpak install --user -y --noninteractive "${fpkgs[@]}" || true
fi
{{ end }}
