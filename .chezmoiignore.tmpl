{{- $des := splitList "," .des -}}
{{- $hypr := has "hyprland" $des -}}
{{- $cosmic := has "cosmic" $des -}}
# Repo-internal files/dirs — never deployed into $HOME.
packages
packages/**
install
install/**
misc
misc/**
scripts
scripts/**
system
system/**
install.sh
README.md
LICENSE.md
AGENTS.md
justfile
.github/**
**/*~
*.bak

# DE-specific config dirs only deploy where that DE is enabled.
{{- if not $hypr }}
.config/hypr
.config/hypr/**
.config/ags
.config/ags/**
.config/waybar
.config/waybar/**
.config/swaync
.config/swaync/**
.config/anyrun
.config/anyrun/**
# hyprland-era helper scripts (hyprctl deps) and wallpaper assets
.local/bin/flocktoggle.sh
.local/bin/fullscreen.py
.local/bin/killactive.py
.local/bin/lib
.local/bin/lib/**
.local/bin/picture_in_picture.py
.local/bin/restart_ags.sh
.local/bin/restart_xdpc.sh
.local/bin/restart_xdph.sh
.local/bin/startup.sh
.local/bin/wallpaper.py
.local/share/dots
.local/share/dots/**
{{- end }}
{{- if not $cosmic }}
.config/cosmic
.config/cosmic/**
{{- end }}

# Fully headless (des=none): skip every GUI-adjacent config.
{{- if and (not $hypr) (not $cosmic) }}
.config/MangoHud
.config/MangoHud/**
.config/vesktop
.config/vesktop/**
.config/electron-flags.conf
.config/mimeapps.list
.config/xdg-desktop-portal
.config/xdg-desktop-portal/**
.config/systemd
.config/systemd/**
.config/environment.d
.config/environment.d/**
.themes
.themes/**
{{- end }}
