hl.window_rule({ match = { class = [[^(steam_app_\d*)$]] }, monitor = primary_display, no_initial_focus = true })

-- fix opera fullscreen/lag
hl.window_rule({ match = { class = [[^([Oo]pera|opera-stable)$]] }, immediate = true })

-- default monitors for apps
hl.window_rule({ match = { class = [[^(vesktop)$]] },                 monitor = top_left_display })
hl.window_rule({ match = { class = [[^([Oo]pera|opera-stable)$]] },   monitor = top_right_display })
hl.window_rule({ match = { class = [[^Code( - (OSS|Insiders))?$]] },  monitor = bottom_left_display })

-- Floating windows
hl.window_rule({ match = { class = [[^(com.gabm.satty)$]] }, float = true })

-- ported from cosmic's tiling_exception_defaults
-- (apps that float instead of tile under cosmic autotile)
hl.window_rule({ match = { class = [[^(steam)$]], title = [[^.*?(Guard|Login).*?$]] }, float = true })
hl.window_rule({ match = { class = [[^(zoom)$]] }, float = true })
hl.window_rule({ match = { class = [[^(TelegramDesktop)$]], title = [[^(Media viewer)$]] }, float = true })
hl.window_rule({ match = { class = [[^(thunderbird)$]], title = [[^(Write:).*$]] }, float = true })
hl.window_rule({ match = { class = [[^(slack|com.slack.Slack)$]], title = [[^.*?(Huddle Preview).*$]] }, float = true })
hl.window_rule({ match = { class = [[^(Enpass)$]], title = [[^(Enpass Assistant)$]] }, float = true })
hl.window_rule({ match = { class = [[^(Solaar)$]] }, float = true })
hl.window_rule({ match = { class = [[^(pritunl)$]] }, float = true })
hl.window_rule({ match = { class = [[^(re.sonny.Junction)$]] }, float = true })
hl.window_rule({ match = { class = [[^(Gjs|gjs)$]] }, float = true })
hl.window_rule({ match = { class = [[^(gnome-screenshot)$]] }, float = true })

-- prism, float popups (title negative-match: everything but the main window)
hl.window_rule({ match = { class = [[^org.prismlauncher.PrismLauncher$]], title = "negative:^Prism Launcher$" }, float = true })

-- tray popups → top-right corner of the monitor
hl.window_rule({ match = { title = [[^(MEGAsync)$]], class = [[^(MEGAsync)$]] }, move = { "monitor_w - window_w", "0" } })
hl.window_rule({ match = { class = [[^(jetbrains-toolbox)$]] }, move = { "monitor_w - window_w", "0" } })

-- -- Fix odd behaviors in IntelliJ IDEs --
-- (windowdance has no lua equivalent — dropped; remaining rules kept)
-- splash screen: center + float + no border/focus
hl.window_rule({ match = { class = [[^jetbrains-]], title = [[^splash$]] }, center = true, float = true })
hl.window_rule({ match = { class = [[^jetbrains-]], title = [[^splash$]] }, no_focus = true })
hl.window_rule({ match = { class = [[^jetbrains-]], title = [[^splash$]] }, border_size = 0 })
-- fix new project showing in weird places
hl.window_rule({ match = { class = [[^jetbrains-]], title = [[^New Project$]] }, center = true, float = true })
-- center popups/find windows (empty-title dialogs)
hl.window_rule({ match = { class = [[^jetbrains-]], title = [[^()$]] }, center = true, float = true })
hl.window_rule({ match = { class = [[^jetbrains-]], title = [[^()$]] }, border_size = 0 })
hl.window_rule({ match = { class = [[^jetbrains-]], title = [[^()$]] }, no_initial_focus = true })
hl.window_rule({ match = { class = [[^jetbrains-]], title = [[^()$]] }, min_size = "950 600" })

hl.window_rule({ match = { title = [[^(warp cloudflare)$]] }, size = { "monitor_w * 0.1", "monitor_h * 0.15" } })
hl.window_rule({ match = { title = [[^(warp cloudflare)$]] }, center = true })
