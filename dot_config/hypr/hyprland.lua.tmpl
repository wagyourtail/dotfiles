-- Hyprland Lua config (hyprlang was removed in Hyprland 0.57).
-- Monitor layout rendered from .chezmoidata/machines.toml → role: {{ .role }}
-- Binds follow COSMIC's model — see the comments inline.

local primary_display = "{{ $m.primary_display }}"
{{- range $name, $val := $m.vars }}
local {{ $name }} = "{{ $val }}"
{{- end }}

-- Monitors — output is a lua identifier (primary_display / vars above), "" is
-- the catch-all default for anything not explicitly configured.
{{ range $m.monitors -}}
hl.monitor({
    output   = {{ if .output }}{{ .output }}{{ else }}""{{ end }},
    mode     = {{ .mode | quote }},
    position = {{ .position | quote }},
    scale    = {{ .scale | quote }},
    {{- if hasKey . "vrr" }}
    vrr      = {{ .vrr }},
    {{- end }}
    {{- if hasKey . "transform" }}
    transform = {{ .transform }},
    {{- end }}
})
{{ end -}}

