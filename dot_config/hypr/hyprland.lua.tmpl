local G     = "SUPER"
local LSG   = "SHIFT + SUPER"
local LAG   = "ALT + SUPER"
local LCG   = "CTRL + SUPER"
local LSAG  = "ALT + SHIFT + SUPER"
local LCAG  = "CTRL + ALT + SUPER"
local LSACG = "CTRL + ALT + SHIFT + SUPER"

-- Fullscreen mode toggles with workspace isolation (native lua replacement
-- for fullscreen.py). mode: 0 = unfullscreen, 1 = maximized, 2 = fullscreen.
-- Entering a mode on a shared workspace first moves the window to the next
-- empty one; pressing the same-mode key while fullscreen sends it back to
-- the first workspace slot (r~1).
local function fs_mode(mode)
    local win = hl.get_active_window()
    if not win then return end
    local set = mode ~= 0 and hl.dsp.window.fullscreen({
        mode = mode == 1 and "maximized" or "fullscreen",
        action = "set",
        window = win,
    })
    local cur = win.fullscreen
    if cur > 0 then
        hl.dispatch(hl.dsp.window.fullscreen({ action = "unset", window = win }))
        if mode == cur then
            hl.dispatch(hl.dsp.window.move({ workspace = "r~1", window = win }))
        elseif set then
            hl.dispatch(set)
        end
    else
        if win.workspace.windows > 1 then
            hl.dispatch(hl.dsp.window.move({ workspace = "emptynm", window = win }))
        end
        if set then hl.dispatch(set) end
    end
end

-- Kill the active window; if it was fullscreen, return the view to workspace
-- slot 1 (replaces killactive.py — pairs with the isolation hook above).
local function kill_active()
    local win = hl.get_active_window()
    local was_fs = win and win.fullscreen and win.fullscreen > 0
    hl.dispatch(hl.dsp.window.close({ window = win }))
    if was_fs then
        hl.dispatch(hl.dsp.focus({ workspace = "r~1" }))
    end
end

-- Picture-in-picture toggle (replaces picture_in_picture.py): float+pin the
-- window at 35%x35% in the monitor's top-right; un-pin restores it. Uses
-- fullscreen_state(internal=0, client=2) — the lua-era fake fullscreen: the
-- app renders fullscreen while the compositor treats it as a normal window.
-- (plain fullscreen blocks resize/move/pin, so it must come last.)
local function pip_toggle()
    local win = hl.get_active_window()
    if not win then return end
    if win.pinned then
        hl.dispatch(hl.dsp.window.fullscreen_state({ internal = 0, client = 0, window = win }))
        hl.dispatch(hl.dsp.window.pin({ action = "toggle", window = win }))
        hl.dispatch(hl.dsp.window.float({ action = "toggle", window = win }))
    else
        hl.dispatch(hl.dsp.window.float({ action = "toggle", window = win }))
        local mon
        pcall(function() mon = win.monitor end)
        if not mon then
            for _, m in ipairs(hl.get_monitors()) do
                if m.focused then mon = m break end
            end
        end
        local mw = mon and mon.width or 1920
        local mh = mon and mon.height or 1080
        hl.dispatch(hl.dsp.window.resize({
            x = math.floor(mw * 0.35), y = math.floor(mh * 0.35),
            relative = false, window = win,
        }))
        hl.dispatch(hl.dsp.window.move({
            x = math.floor(mw * 0.64), y = math.floor(mh * 0.03), window = win,
        }))
        hl.dispatch(hl.dsp.window.pin({ action = "toggle", window = win }))
        hl.dispatch(hl.dsp.window.fullscreen_state({ internal = 0, client = 2, window = win }))
    end
end

