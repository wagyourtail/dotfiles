hl.env("WLR_DRM_NO_ATOMIC", "1")

-- ssh-agent via gpg-agent's systemd user socket (only if it exists)
local ssh_auth_sock = os.getenv("XDG_RUNTIME_DIR") .. "/gnupg/S.gpg-agent.ssh"
local ssh_sock_ok = os.execute("test -S " .. ssh_auth_sock .. " 2>/dev/null")
if ssh_sock_ok == true or ssh_sock_ok == 0 then
    hl.env("SSH_AUTH_SOCK", ssh_auth_sock)
end

