{{- $m := index .machines .role -}}
{{- if eq (len $m.monitors) 0 -}}
{{- fail (printf "machines.%s has no monitors — edit .chezmoidata/machines.toml" .role) -}}
{{- end -}}

#
# Please note not all available settings / options are set here.
# For a full list, see the wiki
#

autogenerated = 0 # remove this line to remove the warning

# Configure Monitors (rendered from .chezmoidata/machines.toml → role: {{ .role }})
# See https://wiki.hyprland.org/Configuring/Monitors/

$primary_display = {{ $m.primary_display }}
{{- range $name, $val := $m.vars }}
${{ $name }} = {{ $val }}
{{- end }}
{{ range $m.monitors -}}
monitor = {{ . }}
{{ end -}}

env = PRIMARY_DISPLAY,$primary_display

env = XCURSOR_SIZE,24
env = QT_QPA_PLATFORMTHEME,qt6ct
env = GTK_THEME,Sweet

$scripts = $HOME/.local/bin

exec-once = /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec-once = swaync
exec-once = ags run
exec-once = /usr/lib/kdeconnectd
exec-once = wl-paste --type text --watch cliphist store #Stores only text data
exec-once = wl-paste --type image --watch cliphist store #Stores only image data
exec-once = nm-applet --indicator # network-manager gui
#exec-once = xembedsniproxy
exec-once = hypridle

exec-once = hyprpm reload

exec-once = $scripts/startup.sh

input {
    kb_layout = us
    kb_variant =
    kb_model = pc105+inet
    kb_options = terminate:ctrl_alt_bksp
    kb_rules =
    repeat_delay = 600
    repeat_rate = 25
    numlock_by_default = true

    # because I move my mouse out before hitting ctrl+c a lot
    # and to fix guake closing when the mouse moves.
    follow_mouse = 2
    mouse_refocus = false

    # fixes guake closing
    float_switch_override_focus = 0

    touchpad {
        natural_scroll = no
    }

    sensitivity = 0
}

general {
    gaps_in = 2
    gaps_out = 4
    border_size = 2
    col.active_border = rgba(B60DC2ee)
    col.inactive_border = rgba(4B0B54ee)

    layout = dwindle

    allow_tearing = true
}

# vrr issue, even on linux 6.8 with my gpu
env = WLR_DRM_NO_ATOMIC,1

plugin {
    hyprwinwrap {
        class = kitty-bg
    }

    hyprexpo {
        columns = 3
        gap_size = 5
        bg_color = rgb(0D1326)
        workspace_method = first r~1

        enable_gesture = false
    }
}

group {

    col.border_active = rgba(B60DC2ee)
    col.border_inactive = rgba(4B0B54ee)

    groupbar {
        text_color = rgb(ffffff)

        col.active = rgba(202436ee)
        col.inactive = rgba(080E1Eee)
    }

}


decoration {
    rounding = 5

    blur {
        enabled = false
        size = 3
        passes = 1
    }

    shadow {
        enabled = false
        range = 4
        render_power = 3
        color = rgba(1a1a1aee)
    }
}

animations {
    enabled = yes

    bezier = myBezier, 0.05, 0.9, 0.1, 1.05

    animation = windows, 1, 7, myBezier
    animation = windowsOut, 1, 7, default, popin 80%
    animation = border, 1, 10, default
    animation = borderangle, 1, 8, default
    animation = fade, 1, 7, default
    animation = workspaces, 1, 6, default
}

dwindle {
    pseudotile = yes
    preserve_split = yes

    no_gaps_when_only=2
}

master {
    new_status = master
}

cursor {
    no_hardware_cursors = yes
}

gestures {
    workspace_swipe = off
}

misc {
    force_default_wallpaper = -1
    vfr = true
}

$LSACG = CTRL ALT SHIFT SUPER
$LSCG = CTRL SHIFT SUPER
$LSAG = ALT SHIFT SUPER
$LCAG = CTRL ALT SUPER
$LSG = SHIFT SUPER
$LCG = CTRL SUPER
$LAG = ALT SUPER
$G = SUPER

# Binds follow COSMIC's model (see /usr/share/cosmic/com.system76.CosmicSettings.Shortcuts):
#   Super            focus / activate        Super+Shift   move window
#   Super+Ctrl       workspace prev/next     Super+Ctrl+Shift  move window to prev/next ws
#   Super+Alt        switch output           Super+Shift+Alt   move window to output

# Session
bind = $G, Escape, exec, hyprlock            # cosmic: LockScreen
bind = $LSG, Escape, exec, wlogout           # cosmic: LogOut
bind = $LAG, Escape, exit                    # cosmic: Terminate
bind = $LCG, Escape, exec, hyprctl reload    # cosmic: Debug
bind = , XF86PowerOff, exec, wlogout         # cosmic: PowerOff osd

# Launchers / apps
bind = CTRL ALT, T, exec, guake              # cosmic: xfce4-terminal --drop-down
bindr = SUPER, SUPER_R, exec, anyrun         # cosmic: Launcher on bare Super
bind = $G, slash, exec, anyrun               # cosmic: Launcher
bind = $G, A, exec, anyrun                   # cosmic: AppLibrary
bind = $G, T, exec, kitty                    # cosmic: Terminal
bind = $G, B, exec, xdg-open http://         # cosmic: WebBrowser
bind = $G, F, exec, xdg-open ~               # cosmic: HomeFolder
# hyprlang noerror true
bind = $G, W, hyprexpo:expo toggle           # cosmic: WorkspaceOverview
# hyprlang noerror false
bind = SUPER, V, exec, cliphist list | wofi -dmenu --allow-images | cliphist decode | wl-copy

# Window close — Alt+F4 like cosmic (Super+Q stays unbound, disabled there too)
bind = ALT, F4, exec, $scripts/killactive.py

# Focus (cosmic: Focus)
bind = $G, Left, movefocus, l
bind = $G, Right, movefocus, r
bind = $G, Up, movefocus, u
bind = $G, Down, movefocus, d
bind = $G, h, movefocus, l
bind = $G, j, movefocus, d
bind = $G, k, movefocus, u
bind = $G, l, movefocus, r
bind = $G, u, changegroupactive, b           # cosmic: Focus(Out)
bind = $G, i, changegroupactive, f           # cosmic: Focus(In)

# Move window directionally (cosmic: Move)
bind = $LSG, Left, movewindow, l
bind = $LSG, Right, movewindow, r
bind = $LSG, Up, movewindow, u
bind = $LSG, Down, movewindow, d
bind = $LSG, h, movewindow, l
bind = $LSG, j, movewindow, d
bind = $LSG, k, movewindow, u
bind = $LSG, l, movewindow, r

# Workspaces (cosmic: Workspace/MoveToWorkspace — r~ = per-monitor like OutputBound)
bind = $G, 1, workspace, r~1
bind = $G, 2, workspace, r~2
bind = $G, 3, workspace, r~3
bind = $G, 4, workspace, r~4
bind = $G, 5, workspace, r~5
bind = $G, 6, workspace, r~6
bind = $G, 7, workspace, r~7
bind = $G, 8, workspace, r~8
bind = $G, 9, workspace, r~9
bind = $G, 0, workspace, r~10
bind = $LSG, 1, movetoworkspace, r~1
bind = $LSG, 2, movetoworkspace, r~2
bind = $LSG, 3, movetoworkspace, r~3
bind = $LSG, 4, movetoworkspace, r~4
bind = $LSG, 5, movetoworkspace, r~5
bind = $LSG, 6, movetoworkspace, r~6
bind = $LSG, 7, movetoworkspace, r~7
bind = $LSG, 8, movetoworkspace, r~8
bind = $LSG, 9, movetoworkspace, r~9
bind = $LSG, 0, movetoworkspace, r~10

# Prev/next workspace (cosmic: Previous/NextWorkspace, MoveToPrev/Next)
bind = $LCG, Left, workspace, m-1
bind = $LCG, Right, workspace, m+1
bind = $LCG, Up, workspace, m-1
bind = $LCG, Down, workspace, m+1
bind = $LCG, h, workspace, m-1
bind = $LCG, l, workspace, m+1
bind = $LCG, k, workspace, m-1
bind = $LCG, j, workspace, m+1
bind = $LSACG, Left, movetoworkspace, m-1
bind = $LSACG, Right, movetoworkspace, m+1
bind = $LSACG, Up, movetoworkspace, m-1
bind = $LSACG, Down, movetoworkspace, m+1
bind = $LSACG, h, movetoworkspace, m-1
bind = $LSACG, l, movetoworkspace, m+1
bind = $LSACG, k, movetoworkspace, m-1
bind = $LSACG, j, movetoworkspace, m+1

# Outputs (cosmic: SwitchOutput / MoveToOutput)
bind = $LAG, Left, focusmonitor, l
bind = $LAG, Right, focusmonitor, r
bind = $LAG, Up, focusmonitor, u
bind = $LAG, Down, focusmonitor, d
bind = $LAG, h, focusmonitor, l
bind = $LAG, j, focusmonitor, d
bind = $LAG, k, focusmonitor, u
bind = $LAG, l, focusmonitor, r
bind = $LSAG, Left, movewindow, mon:l
bind = $LSAG, Right, movewindow, mon:r
bind = $LSAG, Up, movewindow, mon:u
bind = $LSAG, Down, movewindow, mon:d
bind = $LSAG, h, movewindow, mon:l
bind = $LSAG, j, movewindow, mon:d
bind = $LSAG, k, movewindow, mon:u
bind = $LSAG, l, movewindow, mon:r

# Window state (cosmic: Toggle*/Maximize/Fullscreen/Resizing)
bind = $G, O, togglesplit                    # cosmic: ToggleOrientation
bind = $G, S, togglegroup                    # cosmic: ToggleStacking
bind = $G, G, togglefloating                 # cosmic: ToggleWindowFloating
bind = $G, X, swapnext                       # cosmic: SwapWindow
# cosmic ToggleTiling (Super+Y) has no equivalent — hyprland always tiles
bind = $G, M, fullscreen, 1                  # cosmic: Maximize
bind = $G, F11, fullscreen, 0                # cosmic: Fullscreen
bind = $G, R, submap, resize                 # cosmic: Resizing(Outwards)
bind = $LSG, R, submap, resize               # cosmic: Resizing(Inwards)

submap = resize
binde = , Right, resizeactive, 40 0
binde = , Left, resizeactive, -40 0
binde = , Up, resizeactive, 0 -40
binde = , Down, resizeactive, 0 40
binde = , l, resizeactive, 40 0
binde = , h, resizeactive, -40 0
binde = , k, resizeactive, 0 -40
binde = , j, resizeactive, 0 40
binde = $LSG, l, resizeactive, -40 0
binde = $LSG, h, resizeactive, 40 0
binde = $LSG, k, resizeactive, 0 40
binde = $LSG, j, resizeactive, 0 -40
bind = , escape, submap, reset
bind = , Return, submap, reset
bind = $G, R, submap, reset
submap = reset

# Window switcher (cosmic: WindowSwitcher / Previous)
bind = ALT, Tab, cyclenext
bind = ALT SHIFT, Tab, cyclenext, prev
bind = $G, Tab, cyclenext
bind = $LSG, Tab, cyclenext, prev

# Extras — each has a numpad twin (KP_* column) and a non-numpad twin
# (togglegroup/togglesplit/togglefloating already bound above: $G+S/O/G)
bind = $LSG, X, swapsplit
bind = $G, P, exec, $scripts/picture_in_picture.py

# macOS-style zoom: move window to a fresh workspace, maximize it
bind = $G, KP_Begin, exec, $scripts/fullscreen.py 1
bind = $LCG, KP_Begin, exec, $scripts/fullscreen.py
bind = $LCAG, KP_Begin, exec, $scripts/fullscreen.py 2
bind = $LSG, M, exec, $scripts/fullscreen.py 1
bind = $LSACG, M, exec, $scripts/fullscreen.py
bind = $LSAG, M, exec, $scripts/fullscreen.py 2

bind = $G, KP_Delete, togglegroup
bind = $G, KP_Multiply, togglesplit
bind = $G, KP_Divide, swapsplit
bind = $G, KP_End, togglefloating
bind = $G, KP_Next, exec, $scripts/picture_in_picture.py
bind = $G, KP_Up, movewindow, u
bind = $G, KP_Down, movewindow, d
bind = $G, KP_Left, movewindow, l
bind = $G, KP_Right, movewindow, r
bind = $LCG, KP_Up, swapwindow, u
bind = $LCG, KP_Down, swapwindow, d
bind = $LCG, KP_Left, swapwindow, l
bind = $LCG, KP_Right, swapwindow, r

# swap two windows directionally (non-numpad: Super+Ctrl+Alt+dir)
bind = $LCAG, Left, swapwindow, l
bind = $LCAG, Right, swapwindow, r
bind = $LCAG, Up, swapwindow, u
bind = $LCAG, Down, swapwindow, d
bind = $LCAG, h, swapwindow, l
bind = $LCAG, j, swapwindow, d
bind = $LCAG, k, swapwindow, u
bind = $LCAG, l, swapwindow, r

# Screenshotting — Print matches cosmic's Screenshot action
bind = , PRINT, exec, grimblast copy area
bind = ALT, PRINT, exec, grimblast copy active
bind = $LSG, S, exec, grimblast copy area
bind = CTRL ALT, PRINT, exec, grimblast save active - | satty -f -
bind = CTRL SUPER SHIFT, S, exec, grimblast save area - | satty -f -
bind = CTRL, PRINT, exec, grimblast save output - | satty -f -

# Media / brightness / volume (same bindings cosmic uses)
bind = , XF86AudioPrev, exec, playerctl previous
bind = , XF86AudioPlay, exec, playerctl play-pause
bind = , XF86AudioNext, exec, playerctl next
bind = , XF86MonBrightnessUp, exec, brightnessctl set +5%
bind = , XF86MonBrightnessDown, exec, brightnessctl set 5%-
bind = , XF86AudioLowerVolume, exec, pactl set-sink-volume 0 -5%
bind = , XF86AudioRaiseVolume, exec, pactl set-sink-volume 0 +5%
bind = , XF86AudioMute, exec, pactl set-sink-mute 0 toggle

# Move/resize windows with G + LMB/RMB and dragging
bindm = $G, mouse:272, movewindow
bindm = $G, mouse:273, resizewindow
bindm = , mouse:277, movewindow # back

# Scroll through existing workspaces with G + scroll
bind = $G, mouse_down, workspace, e+1
bind = $G, mouse_up, workspace, e-1

# Window Rules

# make guake work properly
windowrulev2 = float, title:^(Guake!)$
# windowrulev2 = pin, title:^(Guake!)$
windowrulev2 = move 10% 0, title:^(Guake!)$
windowrulev2 = move 10% 42, title:^(Guake!)$,onworkspace:m[$primary_display]
windowrulev2 = size 80% 40%, title:^(Guake!)$
windowrulev2 = animation slide top, title:^(Guake!)$
windowrulev2 = noborder, title:^(Guake!)$
windowrulev2 = rounding 0, title:^(Guake!)$


# steam
windowrulev2 = monitor $primary_display, class:^(steam_app_\d*)$
# windowrulev2 = immediate, class:^(steam_app_\d*)$
windowrulev2 = noinitialfocus, class:^(steam_app_\d*)$
windowrulev2 = monitor $primary_display, class:^(steam_app_\d*)$

# fix opera fullscreen/lag
windowrulev2 = immediate, class:^([Oo]pera|opera-stable)$

# default monitors for apps
windowrulev2 = monitor $top_left_display, class:^(vesktop)$
windowrulev2 = monitor $top_right_display, class:^([Oo]pera|opera-stable)$
windowrulev2 = monitor $bottom_left_display, class:^(Code - Insiders)$

# Floating windows
windowrulev2 = float, class:^(com.gabm.satty)$

# ported from cosmic's tiling_exception_defaults
# (apps that float instead of tile under cosmic autotile)
windowrulev2 = float, class:^(steam)$, title:^.*?(Guard|Login).*$
windowrulev2 = float, class:^(zoom)$
windowrulev2 = float, class:^(TelegramDesktop)$, title:^(Media viewer)$
windowrulev2 = float, class:^(thunderbird)$, title:^(Write:).*$
windowrulev2 = float, class:^(slack|com.slack.Slack)$, title:^.*?(Huddle Preview).*$
windowrulev2 = float, class:^(Enpass)$, title:^(Enpass Assistant)$
windowrulev2 = float, class:^(Solaar)$
windowrulev2 = float, class:^(pritunl)$
windowrulev2 = float, class:^(re.sonny.Junction)$
windowrulev2 = float, class:^(Gjs|gjs)$
windowrulev2 = float, class:^(gnome-screenshot)$

# prism, float popups
windowrulev2 = float, class:^(org.prismlauncher.PrismLauncher)$, title:^(?!Prism Launcher).*$

# tray popups
windowrulev2 = move onscreen 100% 0, title:^(MEGAsync)$, class:^(MEGAsync)$
windowrulev2 = move onscreen 100% 0, class:^(jetbrains-toolbox)$

# -- Fix odd behaviors in IntelliJ IDEs --
# https://github.com/hyprwm/Hyprland/issues/3450#issuecomment-1816761575

#! Fix focus issues when dialogs are opened or closed
windowrulev2 = windowdance,class:^(jetbrains-(?!toolbox)),floating:1
#! Fix splash screen showing in weird places and prevent annoying focus takeovers
windowrulev2 = center,class:^(jetbrains-(?!toolbox)),title:^(splash)$,floating:1
windowrulev2 = nofocus,class:^(jetbrains-(?!toolbox)),title:^(splash)$,floating:1
windowrulev2 = noborder,class:^(jetbrains-(?!toolbox)),title:^(splash)$,floating:1

#! fix new project showing in weird places
windowrulev2 = center, class:^(jetbrains-(?!toolbox)),title:^(New Project)$,floating:1

#! Center popups/find windows
windowrulev2 = center,class:^(jetbrains-(?!toolbox)),title:^()$,floating:1
# windowrulev2 = stayfocused,class:^(jetbrains-(?!toolbox)),title:^( )$,floating:1
windowrulev2 = noborder,class:^(jetbrains-(?!toolbox)),title:^()$,floating:1
# Disable window flicker when autocomplete or tooltips appear
windowrulev2 = noinitialfocus,class:^(jetbrains-(?!toolbox)),title:^()$,floating:1
# fix size
windowrulev2 = minsize 950 600,class:^(jetbrains-(?!toolbox)),title:^()$,floating:1

windowrulev2 = size 10% 15%, title:^(warp cloudflare)$
windowrulev2 = center 1, title:^(warp cloudflare)$
